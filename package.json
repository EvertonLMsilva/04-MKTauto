{
  "name": "mktauto-discovery",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:provision": "node dist/infrastructure/administration/provision.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "npm run test:node && npm run test:unit",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "project": "node --env-file-if-exists=.env scripts/operational-cli.mjs project",
    "preview": "node --env-file-if-exists=.env scripts/operational-cli.mjs preview",
    "video:live": "node --env-file-if-exists=.env scripts/operational-cli.mjs video:live",
    "trend:daily": "node --env-file-if-exists=.env scripts/operational-cli.mjs trend:daily",
    "trend:shortlist": "node --env-file-if-exists=.env scripts/operational-cli.mjs trend:shortlist",
    "trend:export": "node --env-file-if-exists=.env scripts/operational-cli.mjs trend:export",
    "drive:authorize": "node --env-file-if-exists=.env scripts/operational-cli.mjs drive:authorize",
    "drive:upload": "node --env-file-if-exists=.env scripts/operational-cli.mjs drive:upload",
    "test:all": "npm test && npm run test:e2e && npm run test:python",
    "test:python": "python -B -m unittest discover -s python/alignment -p \"test_*.py\" && python -B -m unittest discover -s python/tts -p \"test_*.py\"",
    "start:legacy": "node --env-file-if-exists=.env scripts/operational-cli.mjs start:legacy",
    "test:node": "npm run build && node --test \"test/*.test.js\" \"scripts/ops-local/*.test.mjs\"",
    "test:unit": "vitest run",
    "test:postgres": "node test/postgres/run.mjs",
    "test:compiled": "npm run build && node test/project.compiled-smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
