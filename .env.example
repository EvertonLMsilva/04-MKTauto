# Nunca commitar segredos ou valores operacionais reais. Este arquivo nao ativa LIVE.

# Basico: banco existente, provisionado separadamente com db:provision.
# PROJECT_API_DATABASE exige caminho absoluto; nao usar PREVIEW_DATABASE/TREND_DATABASE.
PROJECT_API_DATABASE=
PORT=3000
# Origem HTTP NestJS usada pela CLI; --api-url tem precedencia.
MKTAUTO_API_URL=http://127.0.0.1:3000

# Composicao local opcional. Informar binarios existentes e preparar os roots.
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_VOICE_ROOT=outputs/voice
FFMPEG_MEDIA_ROOT=outputs/media
FFMPEG_RENDER_ROOT=outputs/render
# Deve apontar para o mesmo armazenamento dos renders a verificar.
PUBLISHING_RENDER_ROOT=outputs/render
# Politica fixa: somente estes valores sao aceitos. Nao definir FFMPEG_VIDEO_STAGING_ROOT.
FFMPEG_VIDEO_POLICY_VERSION=ffmpeg-video-policy/1.0.0
FFMPEG_VIDEO_FRAME_RATE=30

# Alinhamento/legendas locais opcionais; nenhum modelo e baixado automaticamente.
LOCAL_MEDIA_EVIDENCE_ROOT=outputs/local-evidence
# Executavel Python e diretorio de modelo devem ser caminhos absolutos.
LOCAL_ALIGNMENT_PYTHON=
LOCAL_ALIGNMENT_MODEL_ROOT=
# SHA-256 real do manifesto do modelo; nao preencher com hash ficticio.
LOCAL_ALIGNMENT_MODEL_SHA256=
# Segredo local de pelo menos 32 caracteres, nunca versionar seu valor real.
LOCAL_ALIGNMENT_EVIDENCE_KEY=
LOCAL_ALIGNMENT_DEVICE=cpu
# Opcional: hashes de evidencias explicitamente autorizadas, separados por virgula.
# LOCAL_ALIGNMENT_EVIDENCE_HASHES=

# Descoberta opcional: caminho absoluto da configuracao externa de feeds/cache.
# AFFILIATE_DISCOVERY_CONFIG=
# Historico social opcional: caminho absoluto de banco existente.
# SOCIAL_HISTORY_DATABASE=

# Scheduler permanece desativado; nao habilitar durante testes comuns.
CAMPAIGN_SCHEDULER_ENABLED=false
# Somente fixtures locais: os modos fake abaixo ficam desativados por padrao.
# CONTENT_EDITORIAL_PROVIDER=fake
# INSTAGRAM_PUBLICATION_MODE=fake
# INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_API_VERSION=
