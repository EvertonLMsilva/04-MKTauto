# Nunca commitar segredos ou valores operacionais reais. Este arquivo nao ativa LIVE.

# Basico: banco existente, provisionado separadamente com db:provision.
# PROJECT_API_DATABASE exige caminho absoluto; nao usar PREVIEW_DATABASE/TREND_DATABASE.
PROJECT_API_DATABASE=
# TTS v2: default off. Requires provisioned schema, individual authenticated risk
# authorization, unexpired request hash and Finance reservation before dispatch.
OPENAI_TTS_LIVE_ENABLED=false
PORT=3000
# Origem HTTP NestJS usada pela CLI; --api-url tem precedencia.
MKTAUTO_API_URL=http://127.0.0.1:3000

# Composicao local opcional. Informar binarios existentes e preparar os roots.
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_VOICE_ROOT=outputs/voice
FFMPEG_MEDIA_ROOT=outputs/media
FFMPEG_RENDER_ROOT=outputs/render
# Deve apontar para o mesmo armazenamento dos renders a verificar.
PUBLISHING_RENDER_ROOT=outputs/render
# Politica fixa: somente estes valores sao aceitos. Nao definir FFMPEG_VIDEO_STAGING_ROOT.
FFMPEG_VIDEO_POLICY_VERSION=ffmpeg-video-policy/1.0.0
FFMPEG_VIDEO_FRAME_RATE=30

# Alinhamento/legendas locais opcionais; nenhum modelo e baixado automaticamente.
LOCAL_MEDIA_EVIDENCE_ROOT=outputs/local-evidence
# QC temporal offline opt-in; usa FFMPEG_PATH, FFPROBE_PATH e FFMPEG_MEDIA_ROOT.
# Mede quadros reais; nao aprova movimento do produto, continuidade ou fidelidade.
TEMPORAL_QC_MODE=disabled
# Fake por padrao; controlled exige plano privado e confirmacao autenticada futura.
FAL_GENERATION_MODE=fake
FAL_CONTROLLED_PLAN_FILE=
# Executavel Python e diretorio de modelo devem ser caminhos absolutos.
LOCAL_ALIGNMENT_PYTHON=
LOCAL_ALIGNMENT_MODEL_ROOT=
# SHA-256 real do manifesto do modelo; nao preencher com hash ficticio.
LOCAL_ALIGNMENT_MODEL_SHA256=
# Segredo local de pelo menos 32 caracteres, nunca versionar seu valor real.
LOCAL_ALIGNMENT_EVIDENCE_KEY=
LOCAL_ALIGNMENT_DEVICE=cpu
# TTS local opcional: apenas arquivos ja instalados, sem download automatico.
# Padrao da campanha: AUTOMATIC; RECORDING preserva o upload manual.
# LOCAL_TTS_MANIFEST=<caminho absoluto do manifesto privado aprovado>
# LOCAL_TTS_MANIFEST_SHA256=<sha256 do manifesto aprovado>
# Alternativa nativa: engine=espeak-ng, modelId=espeak-ng/pt-br, GPL-3.0-or-later.
# Exige inventário espeak-native/1 (DLL, pt-BR, dicionário e tabelas por SHA-256),
# dataRoot absoluto e adapterSha256 de backend/python/tts/espeak.py; sem MBROLA.
# O processo Python usa voz nativa por formantes (padrão: pt-br, 150 palavras/minuto);
# variantes permitidas m1/m3/f2/f3 exigem seu arquivo no inventário. Taxas: 140/150/160.
# A duração
# medida deve caber no vídeo, sem acelerar/cortar fala ou estender cenas.
# schemaVersion=local-tts-license/1, engine=piper, language=pt-BR.
# Exige modelId/modelVersion, modelPath/configPath/executablePath/licenseEvidencePath
# e modelSha256/configSha256/executableSha256/licenseEvidenceSha256 correspondentes.
# Exige license (CC0-1.0, CC-BY-4.0, MIT ou Apache-2.0), licenseSource HTTPS,
# attribution, approvedBy, approvedAt, commercialUseAllowed/localProcessingAllowed=true.
# A aprovacao deve comprovar direitos de modelo/voz/derivacao/saida, nao so do engine.
# Edresson/Ryan e o hash instalado nao sao elegiveis. Nao fabricar o manifesto.
# Opcional: hashes de evidencias explicitamente autorizadas, separados por virgula.
# LOCAL_ALIGNMENT_EVIDENCE_HASHES=

# Descoberta opcional: caminho absoluto da configuracao externa de feeds/cache.
# AFFILIATE_DISCOVERY_CONFIG=
# Historico social opcional: caminho absoluto de banco existente.
# SOCIAL_HISTORY_DATABASE=

# Scheduler permanece desativado; nao habilitar durante testes comuns.
CAMPAIGN_SCHEDULER_ENABLED=false
# Somente fixtures locais: os modos fake abaixo ficam desativados por padrao.
# CONTENT_EDITORIAL_PROVIDER=fake
# INSTAGRAM_PUBLICATION_MODE=fake
# INSTAGRAM_ACCOUNT_ID=
# Aliases legados aceitos quando ACCOUNT_ID nao estiver preenchido:
# INSTAGRAM_IG_USER_ID= ou INSTAGRAM_USER_ID= (devem concordar se ambos presentes).
# INSTAGRAM_API_VERSION=

# Diagnostico somente leitura em /operations, via Facebook Login (nao ativa LIVE).
# Obtenha o Page Access Token no fluxo oficial da Meta, fora desta interface.
# Armazene segredos no ambiente privado do servidor/vault; nunca envie ao browser.
# INSTAGRAM_FACEBOOK_PAGE_ID=
# INSTAGRAM_META_APP_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_ACCESS_TOKEN=
# Requer instagram_basic, instagram_content_publish e pages_read_engagement.
# pages_show_list e necessario para descoberta no onboarding, nao para estas
# consultas com IDs conhecidos. App Review/Advanced Access depende do caso de uso.
# Shopee: fake por padrão; LIVE requer configuração explícita e autorização operacional.
# SHOPEE_AFFILIATE_MODE=
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=
